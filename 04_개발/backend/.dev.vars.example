# Copy to .dev.vars for local development. Never commit .dev.vars.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Real Neon Auth verification.
# Use the Auth URL shown for the Danjion Neon branch. This is a public service URL,
# not a database password or token.
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neon.tech/neondb/auth
# Optional. If omitted, backend derives: <NEON_AUTH_BASE_URL>/.well-known/jwks.json
NEON_AUTH_JWKS_URL=https://YOUR-ENDPOINT.neon.tech/neondb/auth/.well-known/jwks.json

# Local-only compatibility bypass. The shared auth resolver ignores this header
# whenever APP_ENV=production. Keep false when exercising real Neon Auth locally.
DEV_AUTH_BYPASS=false

# To use the existing local seeded development actors only, explicitly set
# DEV_AUTH_BYPASS=true and send one of these request headers:
# x-danjion-dev-auth-user: dev-resident-001
# x-danjion-dev-auth-user: dev-manager-001
# Never use the dev header as a production credential.

# Track C Google Drive storage. These are placeholders only.
# Keep the client secret and refresh token in .dev.vars locally and Cloudflare secrets in deployed environments.
STORAGE_MODE=drive
GOOGLE_DRIVE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-refresh-token
GOOGLE_DRIVE_PUBLIC_BUSINESS_FOLDER_ID=replace-with-drive-folder-id
GOOGLE_DRIVE_PRIVATE_RESIDENT_VERIFICATION_FOLDER_ID=replace-with-drive-folder-id

# Track E Cloudflare preview uses a separate GitHub Actions secret named
# DANJION_PREVIEW_DATABASE_URL. Its value must point to Neon child branch
# cloudflare-preview-20260808 (br-hidden-frog-azdevrqe), never production.
