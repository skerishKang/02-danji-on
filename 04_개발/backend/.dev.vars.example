# Copy to .dev.vars for local development. Never commit .dev.vars.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Danjion Better Auth account/session boundary.
# This is separate from resident verification and from Neon's managed neon_auth schema.
DANJION_AUTH_BASE_URL=http://localhost:8787
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Email is the canonical recovery channel for direct accounts.
# Verification is required by default; set false only for an explicit local/sandbox test.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Provider-neutral transactional email relay. The relay may later be backed by
# Resend, SES, Postmark, or a PADIEM common mail service without exposing provider
# credentials to the browser. Keep the token in .dev.vars / Cloudflare secrets.
AUTH_EMAIL_RELAY_URL=https://replace-with-private-mail-relay.example/send
AUTH_EMAIL_RELAY_TOKEN=replace-with-private-relay-token
AUTH_EMAIL_FROM=단지온 <noreply@example.com>

# Optional social providers. Configure only the providers currently under test.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Product APIs verify Better Auth JWTs at <DANJION_AUTH_BASE_URL>/api/auth/jwks.
# Override only for a controlled deployment topology.
DANJION_AUTH_JWKS_URL=

# Historical managed Neon Auth verification fallback. Keep only while legacy
# preview/live paths still depend on it. New Danjion auth takes precedence when
# DANJION_AUTH_BASE_URL is configured.
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-ENDPOINT.neon.tech/neondb/auth/.well-known/jwks.json

# Local-only compatibility bypass. The shared auth resolver ignores this header
# whenever APP_ENV=production. Keep false when exercising real authentication locally.
DEV_AUTH_BYPASS=false

# To use the existing local seeded development actors only, explicitly set
# DEV_AUTH_BYPASS=true and send one of these request headers:
# x-danjion-dev-auth-user: dev-resident-001
# x-danjion-dev-auth-user: dev-manager-001
# Never use the dev header as a production credential.

# Track C Google Drive storage. These are placeholders only.
# Keep the client secret and refresh token in .dev.vars locally and Cloudflare secrets in deployed environments.
STORAGE_MODE=drive
GOOGLE_DRIVE_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=replace-with-refresh-token
GOOGLE_DRIVE_PUBLIC_BUSINESS_FOLDER_ID=replace-with-drive-folder-id
GOOGLE_DRIVE_PRIVATE_RESIDENT_VERIFICATION_FOLDER_ID=replace-with-drive-folder-id

# Track E Cloudflare preview uses a separate GitHub Actions secret named
# DANJION_PREVIEW_DATABASE_URL. Its value must point to a Neon child branch,
# never production.
