{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danjion-api",
  "main": "src/worker-v2.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "DEV_AUTH_BYPASS": "false",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "env": {
    "preview": {
      "name": "padiem-danjion-api-preview",
      "workers_dev": false,
      "preview_urls": true,
      "vars": {
        "APP_ENV": "preview",
        "DEV_AUTH_BYPASS": "false",
        "CORS_ALLOWED_ORIGINS": "https://*.padiem-danjion-web-preview.pages.dev"
      }
    },
    "qa": {
      "name": "padiem-danjion-api-qa",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "qa",
        "TEMP_RESIDENT_ACCESS_MODE": "true",
        "DEV_AUTH_BYPASS": "false",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "false"
      }
    },
    "production": {
      "name": "padiem-danjion-api-production",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "services": [
        {
          "binding": "PADIEM_CONTACT_VERIFICATION",
          "service": "padiem-contact-verification"
        }
      ],
      "secrets": {
        "required": [
          "DATABASE_URL",
          "BETTER_AUTH_SECRET",
          "DANJION_CONTACT_REF_SECRET",
          "HOUSEHOLD_CODE_PEPPER"
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "COMMUNITY_PUBLISH_MODE": "immediate",
        "STORAGE_MODE": "drive",
        "DEV_AUTH_BYPASS": "false",
        "BUSINESS_IMAGE_RECONCILIATION_ENABLED": "false",
        "DANJION_AUTH_BASE_URL": "https://padiem-danjion-api-production.padiem.workers.dev",
        "CORS_ALLOWED_ORIGINS": "https://danjion.padiem.net,https://danjion.pages.dev",
        "AUTH_TRUSTED_ORIGINS": "https://danjion.padiem.net,https://danjion.pages.dev",
        "AUTH_REQUIRE_EMAIL_VERIFICATION": "false"
      }
    }
  }
}
