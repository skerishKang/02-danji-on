# UI surface selection for the same DanjiOn product codebase.
# v1: existing React functional baseline
# v2: image-refresh React surface
# gateway: lightweight V1/V2 chooser
# Unset/invalid values intentionally fall back to v1.
VITE_UI_VARIANT=v1

# Preview navigation targets. These are public frontend URLs, never secrets.
# The gateway uses V1/V2. Individual versions may use GATEWAY for a return link.
VITE_V1_URL=
VITE_V2_URL=
VITE_GATEWAY_URL=

# mock: v5/shared local mock data
# api: call the Cloudflare Worker API
VITE_DATA_MODE=mock

# dev: current pre-browser-Neon provider
# neon: reserved for the real browser Neon Auth adapter/session bridge
VITE_AUTH_MODE=dev

# mock: browser-only IndexedDB upload + preview
# drive: upload through the backend Google Drive adapter. Never put Google OAuth credentials in Vite env.
VITE_STORAGE_MODE=mock

# Same-origin by default. Set only when frontend/API are served separately.
VITE_API_BASE_URL=
VITE_COMPLEX_SLUG=bangnim-myeongji-roadhill

# Development only. Resident app actor.
# The backend resolves role/membership from DB fixtures; these are auth subjects, not role headers.
VITE_DEV_AUTH_USER=dev-resident-001

# Development only. /admin.html actor.
VITE_DEV_ADMIN_AUTH_USER=dev-manager-001

# Track E Cloudflare preview public-shell build profile (workflow-injected, do not hard-code URL):
# VITE_DATA_MODE=api
# VITE_AUTH_MODE=dev
# VITE_STORAGE_MODE=mock
# VITE_API_BASE_URL=<Cloudflare Worker version preview URL>
#
# A Vite production build does not send x-danjion-dev-auth-user because that
# header is guarded by import.meta.env.DEV. Private live API verification uses
# Track A bearer tokens through Track D's live gate until a browser Neon Auth
# session adapter is connected. Drive mode remains available as VITE_STORAGE_MODE=drive.
#
# V2 program separate-surface preview aliases (same Pages project, separate branches):
# V1:      https://v1.padiem-danjion-web-preview.pages.dev
# V2:      https://v2.padiem-danjion-web-preview.pages.dev
# Gateway: https://gateway.padiem-danjion-web-preview.pages.dev
# Keeping all three under padiem-danjion-web-preview preserves the existing
# preview Worker CORS wildcard without broadening backend production policy.
